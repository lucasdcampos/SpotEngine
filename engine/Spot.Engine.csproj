<Project Sdk="Microsoft.NET.Sdk">

  <!-- Level 3 of Spot: the opinionated engine built on the framework — application host and services, scenes
       and components, systems, scripting, serialization, the asset pipeline, the lit 3D renderer and post
       pipeline, particles, the animator, runtime UI, physics, and the developer console. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <RootNamespace>Spot</RootNamespace>
    <AssemblyName>Spot.Engine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\framework\Spot.Framework.Core\Spot.Framework.Core.csproj" />
    <ProjectReference Include="..\framework\Spot.Framework\Spot.Framework.csproj" />
  </ItemGroup>

  <!-- Source-model import (Assimp) is desktop-only: the browser loads cooked meshes. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\framework\Spot.Framework.Assimp\Spot.Framework.Assimp.csproj" />
  </ItemGroup>

  <!-- Browser-only source: the engine's browser host. Excluded from the desktop target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Browser\**\*.cs" />
  </ItemGroup>

  <!-- Managed dependencies shared by both targets: physics and logging. -->
  <ItemGroup>
    <PackageReference Include="Aether.Physics2D" Version="2.2.0" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- Desktop-only: the ImGui GL extension behind the developer console, the editor and the debug overlay. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
  </ItemGroup>

  <!-- Desktop-only source: the application host, the HDR/bloom/post pipeline (Silk-backed shaders and queries),
       the ImGui services and console, and the authoring-time model/asset tooling. The browser target compiles
       the neutral engine core plus its own host. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <Compile Remove="Core\Application.cs" />
    <Compile Remove="Core\IEngineService.cs" />
    <Compile Remove="Core\IDebugOverlay.cs" />
    <Compile Remove="Core\Services\GraphicsService.cs" />
    <Compile Remove="Core\Services\AudioService.cs" />
    <Compile Remove="Core\Services\ImGuiService.cs" />
    <!-- The HDR/bloom/post pipeline stays desktop-only for now; the browser runs the shared RenderSystem with no
         post-processor installed (see IScenePostProcessor). -->
    <Compile Remove="Rendering\PostProcessingRenderer.cs" />
    <Compile Remove="Rendering\BloomRenderer.cs" />
    <Compile Remove="Scenes\Systems\DesktopScenePostProcessor.cs" />
    <Compile Remove="Assets\ModelMaterials.cs" />
    <Compile Remove="Scenes\ModelInstantiator.cs" />
    <!-- Dear ImGui developer console (authoring/debug overlay). -->
    <Compile Remove="Console\DevConsole.cs" />
    <Compile Remove="Console\DevConsoleSink.cs" />
    <!-- Cook-time source asset importers and the authoring asset database (editor/CLI only; the runtime
         loads cooked content through AssetManifest). -->
    <Compile Remove="Assets\Importers\**\*.cs" />
    <Compile Remove="Assets\AssetDatabase.cs" />
  </ItemGroup>

</Project>
