<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <RootNamespace>Spot.Engine</RootNamespace>
    <AssemblyName>Spot.Engine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    
    
  </ItemGroup>

  <!-- Desktop-only native/interop dependencies: Silk.NET windowing, input, OpenGL and OpenAL. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
  </ItemGroup>

  <!-- Pure managed decoders and libraries -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <PackageReference Include="StbVorbisSharp" Version="1.22.4" />
    <PackageReference Include="Aether.Physics2D" Version="2.2.0" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in default font (Inter Medium, OFL), embedded so text renders with zero setup. -->
    <EmbeddedResource Include="Resources\DefaultFont.ttf" LogicalName="Spot.DefaultFont.ttf" />
  </ItemGroup>

  <!-- Browser-only source: the engine's browser host, WebGL2/Web Audio backends. Excluded from the desktop target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Core\Browser\**\*.cs" />
    <Compile Remove="Core\IO\Browser\**\*.cs" />
  </ItemGroup>

  <!-- Desktop-only source: the application host, the HDR/bloom/post pipeline, ImGui console, etc. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <!-- From Framework -->
    <Compile Remove="Core\Platform\Window.cs" />
    <Compile Remove="Graphics\OpenGLGraphicsDevice.cs" />
    <Compile Remove="Graphics\Renderer.Silk.cs" />
    <Compile Remove="Audio\AudioDevice.cs" />
    <Compile Remove="Audio\OpenAlAudioBackend.cs" />
    
    <!-- From Engine -->
    <Compile Remove="Runtime\Application.cs" />
    <Compile Remove="Runtime\IEngineService.cs" />
    <Compile Remove="Runtime\IDebugOverlay.cs" />
    <Compile Remove="Runtime\Services\GraphicsService.cs" />
    <Compile Remove="Runtime\Services\AudioService.cs" />
    <Compile Remove="Runtime\Services\ImGuiService.cs" />
    <Compile Remove="Graphics\PostProcessingRenderer.cs" />
    <Compile Remove="Graphics\BloomRenderer.cs" />
    <Compile Remove="Scenes\Systems\DesktopScenePostProcessor.cs" />
    <Compile Remove="Assets\ModelMaterials.cs" />
    <Compile Remove="Scenes\ModelInstantiator.cs" />
    <Compile Remove="Console\DevConsole.cs" />
    <Compile Remove="Console\DevConsoleSink.cs" />
    <Compile Remove="Assets\Importers\**\*.cs" />
    <Compile Remove="Assets\AssimpModelImporter.cs" />
    <Compile Remove="Assets\AssetDatabase.cs" />
  </ItemGroup>

</Project>
