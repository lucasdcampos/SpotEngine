<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <RootNamespace>Spot</RootNamespace>
    <AssemblyName>Spot.Engine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in default UI font (Inter Medium, OFL), embedded so in-game text renders with zero setup. -->
    <EmbeddedResource Include="Resources\DefaultFont.ttf" LogicalName="Spot.DefaultFont.ttf" />
  </ItemGroup>

  <!-- Browser-only source: the WebGL2/[JSImport] backends and RAF host. Excluded from the desktop target,
       which uses Silk.NET instead and has no JavaScript interop. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Browser\**\*.cs" />
  </ItemGroup>

  <!-- Managed dependencies shared by both targets: physics, logging, and the Stb* asset decoders are all
       pure managed and link under wasm just as they do on desktop. -->
  <ItemGroup>
    <PackageReference Include="Aether.Physics2D" Version="2.2.0" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <PackageReference Include="StbVorbisSharp" Version="1.22.4" />
  </ItemGroup>

  <!-- Desktop-only native/interop dependencies: Silk.NET windowing, OpenGL, OpenAL, Assimp, and the ImGui
       GL extension. The browser target drives WebGL2/Web Audio/DOM through [JSImport] instead and never
       references Silk.NET. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <!-- Desktop-only source: the Silk.NET windowing/host, the OpenGL/3D/post/particle render pipeline, the
       OpenAL audio backend, the Assimp importer, and the ImGui services. The browser target compiles only
       the neutral engine core (ECS, scenes, scripting, 2D physics, input, audio seam, assets, the 2D/UI
       renderers driven through IGraphicsDevice) plus its own [JSImport] backends. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <Compile Remove="Core\Window.cs" />
    <Compile Remove="Core\Application.cs" />
    <Compile Remove="Core\IEngineService.cs" />
    <Compile Remove="Core\IDebugOverlay.cs" />
    <Compile Remove="Core\Services\GraphicsService.cs" />
    <Compile Remove="Core\Services\AudioService.cs" />
    <Compile Remove="Core\Services\ImGuiService.cs" />
    <Compile Remove="Rendering\OpenGLGraphicsDevice.cs" />
    <Compile Remove="Rendering\Renderer.Silk.cs" />
    <!-- The HDR/bloom/post pipeline stays desktop-only for now (Silk-backed offscreen targets + shaders); the
         browser runs the shared RenderSystem with no post-processor installed (see IScenePostProcessor). -->
    <Compile Remove="Rendering\PostProcessingRenderer.cs" />
    <Compile Remove="Rendering\BloomRenderer.cs" />
    <Compile Remove="Rendering\Framebuffer.cs" />
    <Compile Remove="Scenes\Systems\DesktopScenePostProcessor.cs" />
    <Compile Remove="Audio\AudioDevice.cs" />
    <Compile Remove="Audio\OpenAlAudioBackend.cs" />
    <Compile Remove="Assets\AssimpModelImporter.cs" />
    <Compile Remove="Scenes\ModelInstantiator.cs" />
    <!-- Dear ImGui developer console (authoring/debug overlay). -->
    <Compile Remove="Console\DevConsole.cs" />
    <Compile Remove="Console\DevConsoleSink.cs" />
    <!-- Cook-time source asset importers and the authoring asset database (editor/CLI only; the runtime
         loads cooked content through AssetManifest). -->
    <Compile Remove="Assets\Importers\**\*.cs" />
    <Compile Remove="Assets\AssetDatabase.cs" />
  </ItemGroup>

</Project>
