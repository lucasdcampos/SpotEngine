<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Only the framework levels: these tests prove the core and framework work with no engine at all. -->
  <ItemGroup>
    <ProjectReference Include="..\..\framework\Spot.Framework.Core\Spot.Framework.Core.csproj" />
    <ProjectReference Include="..\..\framework\Spot.Framework\Spot.Framework.csproj" />
    <ProjectReference Include="..\..\framework\Spot.Framework.Assimp\Spot.Framework.Assimp.csproj" />
  </ItemGroup>

  <!-- Test doubles shared with the engine tests (recording graphics device, log sink, media fixtures). -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- Binary fixtures (e.g. a rigged FBX) shared by the test suites. -->
  <ItemGroup>
    <None Include="..\Fixtures\**" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
