<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- EditorGuiIdStackTests clears ImGui's ini path through the native IO struct. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Spot.Engine.csproj" />
    <!-- The editor's undo core and row helpers live in Spot.DebugUI, tested here rather than in a separate
         project. The undo tests make no ImGui call (the one interaction probe sits behind an injectable
         delegate); EditorGuiIdStackTests drives the row helpers in a headless ImGui context. -->
    <ProjectReference Include="..\..\debugui\Spot.DebugUI.csproj" />
  </ItemGroup>

  <!-- Test doubles shared with the framework tests (recording graphics device, log sink, media fixtures). -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
