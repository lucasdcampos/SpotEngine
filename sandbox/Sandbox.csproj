<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sandbox</RootNamespace>
    <AssemblyName>Sandbox</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    In-repo sandbox: references the engine (and Spot.Build, for Project loading) as live source, so it
    compiles against the current engine and doubles as a build-time smoke test of the public API. This
    is intentionally NOT the copied-DLL layout that `spot new` generates for distributable projects.
  -->
  <ItemGroup>
    <ProjectReference Include="..\engine\Spot.Engine.csproj" />
    <ProjectReference Include="..\tools\Spot.Build\Spot.Build.csproj" />
  </ItemGroup>

  <!-- The .sptproj and all assets are copied next to the executable so paths resolve identically
       whether launched via `dotnet run` (any working directory) or from a published build. -->
  <ItemGroup>
    <None Include="Sandbox.sptproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
