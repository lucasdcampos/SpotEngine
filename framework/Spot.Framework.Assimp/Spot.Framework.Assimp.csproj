<Project Sdk="Microsoft.NET.Sdk">

  <!-- Level 2 module: imports source models (.fbx, .gltf, .obj, ...) at runtime through Assimp. A separate
       assembly because Assimp is a native dependency — reference it only if you load source models. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spot</RootNamespace>
    <AssemblyName>Spot.Framework.Assimp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spot.Framework\Spot.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
  </ItemGroup>

</Project>
